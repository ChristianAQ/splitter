# Firebase Web App config (Project settings → General → Your apps → SDK setup).
# These are PUBLIC identifiers (not secrets) — they get bundled into the
# client JS. The real access boundary is firestore.rules, not this file.
# Copy this to .env before running `npm run dev` / `npm run build`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
