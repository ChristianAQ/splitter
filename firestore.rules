rules_version = '2';

// ---------------------------------------------------------------------------
// Splitter — Firestore Security Rules
//
// Threat model this file defends against (see README "Seguridad" section):
//   - A user reading another user's personal data (expenses, profile).
//   - A user reading/joining a group they don't belong to.
//   - A user editing or deleting an expense/payment they didn't create,
//     even if they participate in it.
//   - A user forging `createdBy`/`paidBy`/`groupId`/amounts/splits on write.
//   - A user tampering with membership (memberIds, roles) directly.
//   - A user reading group internals (expenses, balances, members) merely by
//     knowing (or brute-forcing) an invite code.
//
// Design decisions:
//   - Membership is denormalized onto `groups/{groupId}.memberIds` (array of
//     uids) so every subcollection rule can check membership with a single
//     `get()` instead of a query. It is written ONLY by the group-creation
//     transaction and the `joinGroupByCode` Cloud Function (Admin SDK,
//     bypasses rules) — client `update` rules explicitly forbid touching it.
//   - Joining a group by code is NOT a client-side Firestore write. The
//     `inviteCodes/{code}` collection exposes only non-sensitive preview
//     fields (name/icon/color/member count) for the "vas a unirte a X"
//     screen; the actual join is a Cloud Function so a manipulated client
//     can never add itself to `memberIds` or fabricate a `members/{uid}` doc.
//   - Expenses/payments are soft-deleted (`deleted: true`) via `update`, not
//     `delete`, so financial history is never destroyed — and so the
//     creator-only check (which lives on `update`) also covers "deletion".
//   - `history/*` is append-only: create is allowed, update/delete are not.
//   - All helper functions live *inside* `match /databases/{database}/documents`
//     — a function declared outside that block can't see the `database` path
//     variable, so `get(/databases/$(database)/...)` inside it silently
//     resolves against an unbound variable instead of failing loudly. Keep
//     every helper in this file inside that block.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn() &&
        groupDoc(groupId).data.createdBy == request.auth.uid;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function isPositiveAmount(value) {
      return value is number && value > 0 && value < 10000000;
    }

    // -----------------------------------------------------------------
    // Users
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.currency in ['EUR', 'USD', 'GBP']
        && request.resource.data.theme in ['light', 'dark', 'system'];
      allow update: if isSelf(uid)
        && unchanged('uid')
        && unchanged('email')
        && unchanged('createdAt')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.currency in ['EUR', 'USD', 'GBP']
        && request.resource.data.theme in ['light', 'dark', 'system'];
      // Account deletion cascades (personal data + auth user) — handled by
      // the `deleteAccount` Cloud Function, never a direct client delete.
      allow delete: if false;

      match /personalExpenses/{expenseId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.ownerId == uid
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.status in ['future', 'pending', 'done'];
        allow update: if isSelf(uid)
          && unchanged('ownerId')
          && unchanged('createdAt')
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.status in ['future', 'pending', 'done'];
        allow delete: if isSelf(uid);
      }

      match /recurringExpenses/{recurringId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.ownerId == uid
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.periodicity in ['weekly', 'monthly', 'yearly'];
        allow update: if isSelf(uid)
          && unchanged('ownerId')
          && unchanged('createdAt')
          && isPositiveAmount(request.resource.data.amount);
        allow delete: if isSelf(uid);
      }
    }

    // -----------------------------------------------------------------
    // Invite code preview — deliberately minimal fields only.
    // Real joins go through the joinGroupByCode Cloud Function.
    // -----------------------------------------------------------------
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    // -----------------------------------------------------------------
    // Groups
    // -----------------------------------------------------------------
    match /groups/{groupId} {
      // Reads `resource.data` directly rather than the `isMember()` helper
      // (which re-fetches the group via `get()`) — for a read/get on this
      // exact document, `resource` already *is* that document, so the
      // extra self-get is both wasteful and unnecessary.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Group creation always goes through the `createGroup` Cloud Function
      // (Admin SDK), never a client write — it has to mint the paired
      // `inviteCodes/{code}` doc in the same batch, and that collection is
      // `write: false` for every client below. No client `create` path
      // exists here on purpose.
      allow create: if false;

      // Only the admin may rename/re-theme/archive the group. `memberIds`
      // and `createdBy` and `inviteCode` can never be changed from the
      // client — membership changes go through Cloud Functions, and code
      // rotation goes through `regenerateInviteCode`.
      allow update: if isGroupAdmin(groupId)
        && unchanged('createdBy')
        && unchanged('memberIds')
        && unchanged('inviteCode')
        && unchanged('createdAt')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow delete: if false; // archive (update) instead of destroying history

      match /members/{memberUid} {
        // Reads via the parent path directly — same rationale as the group
        // doc's own read rule above (avoids a redundant get() and, unlike
        // isMember(), works even from a `list` query over this subcollection).
        allow read: if isSignedIn() && request.auth.uid in groupDoc(groupId).data.memberIds;

        // Member docs are only ever created by the `createGroup` (admin,
        // on group creation) and `joinGroupByCode` (member, on join) Cloud
        // Functions — both use the Admin SDK and so bypass these rules
        // entirely. No client `create` path exists here on purpose.
        allow create: if false;

        // A member may update their own color or mark themselves inactive
        // (leaving). The admin may rename members or reactivate/deactivate
        // them. Nobody may change `uid`, `role`, or `joinedAt`.
        allow update: if isMember(groupId)
          && unchanged('uid')
          && unchanged('role')
          && unchanged('joinedAt')
          && (
            (isSelf(memberUid) && unchanged('name'))
            || isGroupAdmin(groupId)
          );

        allow delete: if false; // leaving = active:false, keeps expense attribution
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && request.resource.data.groupId == groupId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.paidBy in groupDoc(groupId).data.memberIds
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.splitMethod in ['equal', 'amount']
          && request.resource.data.participants is list
          && request.resource.data.participants.size() > 0
          && request.resource.data.deleted == false;

        // Only the creator may edit — including the "delete" (soft-delete
        // via `deleted: true`), which is why this is the only write path.
        allow update: if isMember(groupId)
          && resource.data.createdBy == request.auth.uid
          && unchanged('createdBy')
          && unchanged('groupId')
          && unchanged('createdAt')
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.splitMethod in ['equal', 'amount'];

        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && request.resource.data.groupId == groupId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.fromUid in groupDoc(groupId).data.memberIds
          && request.resource.data.toUid in groupDoc(groupId).data.memberIds
          && request.resource.data.fromUid != request.resource.data.toUid
          && isPositiveAmount(request.resource.data.amount)
          && request.resource.data.status in ['pending', 'confirmed'];

        // Only the creator may revert (soft-delete) or edit status; the
        // amount/parties of a payment are immutable once recorded — a
        // wrong payment must be reverted and re-created, never mutated in
        // place, so the audit trail always matches what actually happened.
        allow update: if isMember(groupId)
          && resource.data.createdBy == request.auth.uid
          && unchanged('createdBy')
          && unchanged('groupId')
          && unchanged('fromUid')
          && unchanged('toUid')
          && unchanged('amount')
          && unchanged('createdAt')
          && request.resource.data.status in ['pending', 'confirmed'];

        allow delete: if false;
      }

      match /history/{historyId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.groupId == groupId
          && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
